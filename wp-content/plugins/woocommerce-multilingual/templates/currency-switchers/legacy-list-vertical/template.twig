<div class="{{ css_classes }}" >
	<ul>
		{% for currency in currencies %}
			<li {% if( currency == selected_currency) %} class="wcml-cs-active-currency" {% endif %} >
				<button type="button" data-currency="{{ currency }}"{% if currency == selected_currency %} aria-current="true"{% endif %}>{{ get_formatted_price( currency, format )|raw }}</button>
			</li>
		{% endfor %}
	</ul>
</div>