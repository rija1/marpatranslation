<div class="{{ css_classes }} js-wcml-dropdown-click" >
	<ul>
		<li class="wcml-cs-active-currency" >
			<button type="button" class="js-wcml-dropdown-click-toggle wcml-cs-item-toggle" aria-current="true" aria-haspopup="true" aria-expanded="false">{{ get_formatted_price( selected_currency, format )|raw }}</button>
			<ul class="wcml-cs-submenu js-wcml-dropdown-click-submenu">
				{% for currency in currencies %}
					{% if currency != selected_currency %}
						<li>
							<button type="button" data-currency="{{ currency }}">{{ get_formatted_price( currency, format )|raw }}</button>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</li>
	</ul>
</div>