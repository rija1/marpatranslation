#. translators: Heading of the group of a product's variation fields in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:300
msgid "Variations data"
msgstr "Дані варіацій"

#. translators: %s is a product ID
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:314
#, php-format
msgid "Download Files for Variation #%s"
msgstr "Файли для завантаження для варіації №%s"

#. translators: Heading of the group of downloadable-file fields of a product in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:317
