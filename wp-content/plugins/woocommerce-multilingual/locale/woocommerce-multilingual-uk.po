#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:88
msgid "Product tag base"
msgstr "База тегів товарів"

#. translators: Row label on the store URLs screen for the URL part that precedes every product-attribute address.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:90
msgid "Product attribute base"
msgstr "База атрибутів товарів"

#. translators: %s is a slug
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:94
#, php-format
msgid "Attribute slug: %s"
msgstr "Частина посилання атрибута: %s"

#. translators: Name of the kind of content being translated, shown at the top of WPML's translation editor. Noun, singular.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:117
msgid "Product"
msgstr "Товар"

#. translators: Label of the field holding the readable part of a product's web address, in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:187
msgid "Slug"
msgstr "Частина посилання"

