#. Plugin Name of the plugin
#. translators: The plugin's own name, used as a link text, as a link tooltip and as the admin menu label. It is a product name and stays in English.
#: wpml-woocommerce.php
#: classes/AdminNotices/ExportImport.php:189
#: inc/admin-menus/class-wcml-admin-menus.php:419
msgid "WPML Multilingual & Multicurrency for WooCommerce"
msgstr "WPML Multilingual & Multicurrency for WooCommerce"

#. Plugin URI of the plugin
#: wpml-woocommerce.php
msgid "https://wpml.org/documentation/wpml-core-and-add-on-plugins/woocommerce-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wcml"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/woocommerce-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wcml"

#. Description of the plugin
#: wpml-woocommerce.php
msgid "Make your store multilingual and enable multiple currencies | <a href=\"https://wpml.org/documentation/wpml-core-and-add-on-plugins/woocommerce-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wcml\">Documentation</a>"
msgstr "상점을 다국어로 만들고 다중 통화를 활성화하세요 | <a href=\"https://wpml.org/documentation/wpml-core-and-add-on-plugins/woocommerce-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wcml\">문서</a>"

#. Author of the plugin
#: wpml-woocommerce.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: wpml-woocommerce.php
msgid "http://www.onthegosystems.com/"
msgstr "http://www.onthegosystems.com/"

#. translators: Description of the language input offered to an AI assistant that queries WooCommerce products and orders.
#: classes/Abilities/Hooks.php:75
msgid "Language of the content to read."
msgstr "읽을 콘텐츠의 언어입니다."

#. translators: Description of the currency input offered to an AI assistant that queries WooCommerce products and orders.
#: classes/Abilities/Hooks.php:87
msgid "Currency for the returned prices."
msgstr "반환된 가격의 통화입니다."

#. translators: Heading of an admin notice about a caching plugin. "WPML Multilingual & Multicurrency for WooCommerce" is the plugin name and stays in English.
#: classes/AdminNotices/CachePlugins.php:34
msgid "WPML Multilingual & Multicurrency for WooCommerce detected an active cache plugin on your site."
msgstr "WPML Multilingual & Multicurrency for WooCommerce가 사이트에서 활성 캐시 플러그인을 감지했습니다."

#. translators: First line of the admin notice about a caching plugin, under the heading.
#: classes/AdminNotices/CachePlugins.php:36
msgid "Caching may cause currency display issues for your customers if you are using the multicurrency feature."
msgstr "다중 통화 기능을 사용하는 경우 캐싱으로 인해 고객에게 통화 표시 문제가 발생할 수 있습니다."

#. translators: Last line of the admin notice about a caching plugin; "this" is the wrong currency being shown to shoppers.
#: classes/AdminNotices/CachePlugins.php:38
msgid "To avoid this, set your cache plugin to not cache pages for visitors that have a cookie set in their browser."
msgstr "이를 방지하려면 브라우저에 쿠키가 설정된 방문자에 대해 캐시 플러그인이 페이지를 캐싱하지 않도록 설정하세요."

#. translators: Heading of an admin notice telling the shop owner that Twig currency-switcher templates are going away. Keep the bold tags around the feature name.
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:56
msgid "Important: Action Needed for Your <b>Currency Switcher</b>"
msgstr "중요: <b>통화 전환기</b>에 대한 조치가 필요합니다"

#. translators: First paragraph of the admin notice about Twig currency-switcher templates. Keep the bold tags around the feature name; "Twig" is a template technology and stays in English.
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:58
msgid "We detected that your site is using a <b>Currency Switcher</b> built with Twig templates. For security reasons, support for Twig-based templates will be discontinued in the upcoming version of WPML Multilingual & Multicurrency for WooCommerce 5.6."
msgstr "사이트에서 Twig 템플릿으로 제작된 <b>통화 전환기</b>를 사용 중인 것으로 감지되었습니다. 보안상의 이유로 곧 출시될 WPML Multilingual & Multicurrency for WooCommerce 5.6 버전부터 Twig 기반 템플릿 지원이 중단됩니다."

#. translators: Line that introduces the list of steps in the admin notice about Twig currency-switcher templates. Keep the bold tags around the feature name.
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:60
msgid "To ensure your <b>Currency Switcher</b> continues working smoothly:"
msgstr "<b>통화 전환기</b>가 계속 원활하게 작동하도록 하려면:"

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:66
#, php-format
msgid "- Switch to a PHP-based template - you can select one from the %1$sconfiguration page%2$s."
msgstr "- PHP 기반 템플릿으로 전환하세요. %1$s구성 페이지%2$s에서 선택할 수 있습니다."

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:74
#, php-format
msgid "- Need a custom solution? %1$sContact our support%2$s - we’re here to help you migrate safely."
msgstr "- 맞춤형 솔루션이 필요하신가요? %1$s지원팀에 문의%2$s하세요. 안전한 마이그레이션을 도와드리겠습니다."

#. translators: Closing paragraph of the admin notice about Twig currency-switcher templates. Keep the bold tags around the feature name.
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:81
msgid "We recommend updating your <b>Currency Switcher</b> as soon as possible to avoid disruptions when the new version of WPML Multilingual & Multicurrency for WooCommerce is released."
msgstr "새 버전의 WPML Multilingual & Multicurrency for WooCommerce가 출시될 때 중단을 방지하려면 가능한 한 빨리 <b>통화 전환기</b>를 업데이트하는 것이 좋습니다."

#. translators: %s is a link.
#: classes/AdminNotices/ExportImport.php:154
#, php-format
msgid "Migrating your multilingual shop? With %s you can transfer your translated content to a new site, including cross-sells, up-sells, and product attributes."
msgstr "다국어 상점을 이전하시나요? %s를 사용하면 교차 판매, 업셀 및 상품 속성을 포함하여 번역된 콘텐츠를 새 사이트로 전송할 수 있습니다."

#. translators: %1$s and %2$s are both links.
#: classes/AdminNotices/ExportImport.php:165
#, php-format
msgid "Looking to import your multilingual shop? With %1$s and %2$s in both your original and new site, you can export and import your translations automatically."
msgstr "다국어 상점을 가져오고 싶으신가요? 원본 사이트와 새 사이트 모두에 %1$s 및 %2$s가 있으면 번역을 자동으로 내보내고 가져올 수 있습니다."

#. translators: Name of the WPML Export and Import plugin, used as a link text and as the link's tooltip in an admin notice. It is a product name and stays in English.
#: classes/AdminNotices/ExportImport.php:177
msgid "WPML Export and Import"
msgstr "WPML Export and Import"

#. translators: Heading of an admin notice shown when multicurrency is on but only one currency exists.
#: classes/AdminNotices/MultiCurrencyMissing.php:52
msgid "You haven't added any secondary currencies"
msgstr "보조 통화가 추가되지 않았습니다"

#. translators: Body of the admin notice shown when multicurrency is on but only one currency exists; "this setting" is multicurrency mode.
#: classes/AdminNotices/MultiCurrencyMissing.php:54
msgid "Please add another currency to fully utilize multicurrency mode. If you do not need multiple currencies, you can disable this setting to improve your site's performance."
msgstr "다중 통화 모드를 완전히 활용하려면 다른 통화를 추가하세요. 다중 통화가 필요하지 않은 경우 이 설정을 비활성화하여 사이트 성능을 향상시킬 수 있습니다."

#. translators: Link text at the end of the admin notice about having only one currency; it opens the multicurrency settings tab.
#: classes/AdminNotices/MultiCurrencyMissing.php:58
msgid "Configure multicurrency mode"
msgstr "다중 통화 모드 구성"

#. translators: Button label in an admin notice that opens the plugin's review page on WordPress.org. Verb, imperative: write a review.
#: classes/AdminNotices/Review.php:48
msgid "Review WPML Multilingual & Multicurrency for WooCommerce"
msgstr "WPML Multilingual & Multicurrency for WooCommerce 검토"

#. translators: Heading of the admin notice that congratulates the shop owner on the first order paid in a secondary currency.
#: classes/AdminNotices/Review.php:60
msgid "Congrats on making your first multicurrency sale!"
msgstr "첫 번째 다중 통화 판매를 축하합니다!"

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: classes/AdminNotices/Review.php:66
#, php-format
msgid "Want to help <strong>WPML Multilingual & Multicurrency for WooCommerce</strong> plugin? %1$sGive us a review%2$s!"
msgstr "<strong>WPML Multilingual & Multicurrency for WooCommerce</strong> 플러그인을 도와주시겠습니까? %1$s리뷰를 남겨주세요%2$s!"

#. translators: Only entry of the currency dropdown on the WooCommerce reports, shown when the shop has no orders yet.
#: classes/currencies/class-wcml-admin-currency-selector.php:89
#: inc/currencies/class-wcml-multi-currency-reports.php:164
msgid "Currency - no orders found"
msgstr "통화 - 주문을 찾을 수 없음"

#. translators: Error returned when a request carries an expired or missing security token.
#: classes/currencies/class-wcml-admin-currency-selector.php:108
#: classes/Multicurrency/StripeConnect/Hooks.php:68
#: compatibility/WcBookings/MulticurrencyHooks.php:736
#: inc/class-wcml-orders.php:279
#: inc/currencies/class-wcml-multi-currency-orders.php:439
#: inc/currencies/class-wcml-multi-currency-reports.php:139
msgid "Invalid nonce"
msgstr "유효하지 않은 보안 토큰입니다."

#. translators: First line of the notice shown after saving a variable product, when only the product's own fields were synced.
#: classes/EditorScopedSync/Notices.php:196
msgid "WPML synced translations for product-level changes only."
msgstr "WPML이 상품 수준 변경 사항에 대해서만 번역을 동기화했습니다."

#. translators: 1: number of synced variations, 2: total variations in product
#: classes/EditorScopedSync/Notices.php:200
#, php-format
msgid "WPML synced translations for %1$d of %2$d variations."
msgstr "WPML이 %2$d개의 변형 중 %1$d개에 대한 번역을 동기화했습니다."

#. translators: %d: number of variations that were not checked
#: classes/EditorScopedSync/Notices.php:214
#, php-format
msgid "%d other variation was not checked because its data didn't change here."
msgid_plural "%d other variations were not checked because their data didn't change here."
msgstr[0] "데이터가 여기서 변경되지 않았기 때문에 다른 %d개의 변형은 확인되지 않았습니다."

#. translators: %s: "Force update all" label
#: classes/EditorScopedSync/Notices.php:228
#, php-format
msgid "If you've made changes <strong>outside this editor</strong> (for example, retranslating an attribute term), use <em>%s</em> below to make sure every translation is current."
msgstr "<strong>이 에디터 외부</strong>에서 변경한 사항이 있는 경우(예: 속성 용어 재번역), 아래의 <em>%s</em>를 사용하여 모든 번역이 최신 상태인지 확인하세요."

#. translators: Name of the button on the same notice, used inside the sentence above it. Verb phrase, imperative: sync every variation now.
#: classes/EditorScopedSync/Notices.php:230
msgid "Force update all"
msgstr "모두 강제 업데이트"

#. translators: Button label on the notice shown after saving a variable product. Verb, imperative.
#: classes/EditorScopedSync/Notices.php:236
msgid "Force update all variation translations"
msgstr "모든 변형 번역 강제 업데이트"

#. translators: %s: link to the WCML Settings page
#: classes/EditorScopedSync/Notices.php:243
#, php-format
msgid "You can switch to <em>\"Always check all variations\"</em> on the %s."
msgstr "%s에서 <em>“항상 모든 변형 확인”</em>으로 전환할 수 있습니다."

#. translators: Link text pointing at the plugin's Settings page, inside the notice shown after saving a variable product.
#: classes/EditorScopedSync/Notices.php:248
#: classes/EditorScopedSync/Notices.php:444
msgid "WCML Settings page"
msgstr "WCML 설정 페이지"

#. translators: Text read out by screen readers after a link that opens in a new browser tab.
#: classes/EditorScopedSync/Notices.php:250
#: classes/EditorScopedSync/Notices.php:446
msgid "(opens in a new tab)"
msgstr "(새 탭에서 열림)"

#. translators: Label the button changes to while it is syncing every variation of the product.
#: classes/EditorScopedSync/Notices.php:264
msgid "Syncing all variations…"
msgstr "모든 변형 동기화 중…"

#. translators: Label the button changes to when syncing every variation has finished.
#: classes/EditorScopedSync/Notices.php:275
msgid "Done — all variations synced"
msgstr "완료 — 모든 변형 동기화됨"

#. translators: Confirmation shown next to the button after every variation was synced. %d: the product's numeric ID.
#: classes/EditorScopedSync/Notices.php:278
#, php-format
msgid "Sync completed for product #%d."
msgstr "상품 #%d에 대한 동기화가 완료되었습니다."

#. translators: Label the button changes to when syncing the variations failed; "console" is the browser's developer console.
#: classes/EditorScopedSync/Notices.php:281
msgid "Failed — see console"
msgstr "실패 — 콘솔을 확인하세요"

#. translators: Start of the button label when syncing the variations threw an error; the error text is appended after it. Keep the trailing space.
#: classes/EditorScopedSync/Notices.php:285
msgid "Error — "
msgstr "오류 — "

#. translators: Accessible label (screen readers) of the close button that hides an admin notice. Verb, imperative.
#: classes/EditorScopedSync/Notices.php:413
#: inc/admin-menus/class-wcml-admin-menus.php:356
#: inc/class-wcml-cart-sync-warnings.php:94
msgid "Dismiss"
msgstr "무시하기"

#. translators: 1: number of variations checked, 2: number of translation languages
#: classes/EditorScopedSync/Notices.php:418
#, php-format
msgid "WPML verified %1$d variation × %2$d language on this save. None of them had changes that needed syncing."
msgid_plural "WPML verified %1$d variations × %2$d languages on this save. None of them had changes that needed syncing."
msgstr[0] "WPML이 이번 저장에서 %1$d개의 변형 × %2$d개의 언어를 확인했습니다. 동기화가 필요한 변경 사항이 있는 항목은 없었습니다."

#. translators: Second paragraph of the notice shown after a save that checked every variation and changed none; the quoted text is the name of a setting on the plugin's Settings page and is translated the same way there.
#: classes/EditorScopedSync/Notices.php:432
msgid "That's wasted work. Switching to <em>\"Only sync variations edited in the editor\"</em> would make saves like this much faster — WPML will only sync the variations you actually changed and tell you what was skipped."
msgstr "불필요한 작업이 발생했습니다. <em>“에디터에서 편집된 변형만 동기화”</em>로 전환하면 이와 같은 저장이 훨씬 빨라집니다. WPML은 실제로 변경한 변형만 동기화하고 건너뛴 항목을 알려줍니다."

#. translators: %s: link to the WCML Settings page
#: classes/EditorScopedSync/Notices.php:439
#, php-format
msgid "You can switch on the %s."
msgstr "%s에서 전환할 수 있습니다."

#. translators: Link text that permanently hides the notice about variation syncing. Verb phrase, imperative.
#: classes/EditorScopedSync/Notices.php:452
msgid "Don't show this again on this site"
msgstr "이 사이트에서 다시 표시하지 않음"

#. translators: Heading of the section on the plugin's Settings page that controls how variations are synced.
#: classes/EditorScopedSync/Settings.php:81
msgid "Variation translation sync on product save"
msgstr "상품 저장 시 변형 번역 동기화"

#. translators: Tooltip of the help icon next to the variation-sync heading on the Settings page. "Translation Dashboard" and "Translate Everything Automatically" are WPML screen names.
#: classes/EditorScopedSync/Settings.php:82
msgid "Choose how WPML updates variation translations when you save a variable product. Affects saves in the WooCommerce product editor only — Translation Dashboard and Translate Everything Automatically always run a complete sync."
msgstr "가변 상품을 저장할 때 WPML이 변형 번역을 업데이트하는 방법을 선택하세요. WooCommerce 상품 에디터에서의 저장에만 영향을 미칩니다. 번역 대시보드 및 모든 항목 자동 번역은 항상 전체 동기화를 실행합니다."

#. translators: First line under the variation-sync heading on the Settings page.
#: classes/EditorScopedSync/Settings.php:87
msgid "Choose how WPML updates variation translations when you save a variable product."
msgstr "가변 상품을 저장할 때 WPML이 변형 번역을 업데이트하는 방법을 선택하세요."

#. translators: Second line under the variation-sync heading on the Settings page. Keep the bold tags around the WPML screen names.
#: classes/EditorScopedSync/Settings.php:90
msgid "Affects saves in the WooCommerce product editor only. <b>Translation Dashboard</b> and <b>Translate Everything</b> Automatically always run a complete sync."
msgstr "WooCommerce 상품 에디터에서의 저장에만 영향을 미칩니다. <b>번역 대시보드</b> 및 <b>모든 항목 자동 번역</b>은 항상 전체 동기화를 실행합니다."

#. translators: Label of the first radio button of the variation-sync setting. Verb phrase, imperative.
#: classes/EditorScopedSync/Settings.php:99
msgid "Always check all variations"
msgstr "항상 모든 변형 확인"

#. translators: Explanation under the first radio button of the variation-sync setting.
#: classes/EditorScopedSync/Settings.php:101
msgid "On every save, WPML checks every variation in every language and syncs anything that's out of date."
msgstr "저장할 때마다 WPML은 모든 언어의 모든 변형을 확인하고 최신 상태가 아닌 항목을 동기화합니다."

#. translators: Label of the second radio button of the variation-sync setting. Verb phrase, imperative; "the editor" is the WooCommerce product editor.
#: classes/EditorScopedSync/Settings.php:111
msgid "Only sync variations edited in the editor"
msgstr "에디터에서 편집된 변형만 동기화"

#. translators: Explanation under the second radio button of the variation-sync setting.
#: classes/EditorScopedSync/Settings.php:113
msgid "WPML syncs only the variations changed in this save. After each save, WPML shows what was synced and offers a one-click full sync."
msgstr "WPML은 이번 저장에서 변경된 변형만 동기화합니다. 저장 후 WPML은 동기화된 항목을 보여주고 원클릭 전체 동기화를 제공합니다."

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: classes/Email/Settings/TranslationControls.php:119
#, php-format
msgid "To translate custom WooCommerce email notifications, go to the %1$sTranslation Dashboard%2$s."
msgstr "사용자 정의 WooCommerce 이메일 알림을 번역하려면 %1$s번역 대시보드%2$s로 이동하세요."

#. translators: %s is the month day
#: classes/multi-currency/class-wcml-exchange-rates.php:416
#, php-format
msgid "Monthly on the %s"
msgstr "매월 %s일에"

#. translators: %s is the week day
#: classes/multi-currency/class-wcml-exchange-rates.php:425
#, php-format
msgid "Weekly on %s"
msgstr "매주 %s에"

#. translators: Error shown on the multicurrency screen when the exchange-rate service could not be reached.
#: classes/multi-currency/exchange-rate-services/Service.php:169
msgid "Cannot get exchange rates. Connection failed."
msgstr "환율을 가져올 수 없습니다. 연결에 실패했습니다."

#. translators: 1: Currency, 2: Cart total.
#: classes/multi-currency/payment-gateways/class-wcml-currencies-payment-gateways.php:293
#, php-format
msgid "Please note that the payment will be made in %1$s. Your total will be approximately %2$s, depending on the current exchange rate."
msgstr "결제는 %1$s로 이루어집니다. 현재 환율에 따라 총액은 약 %2$s입니다."

#. translators: Status shown next to a payment method WPML cannot yet set currencies for.
#: classes/multi-currency/payment-gateways/class-wcml-not-supported-payment-gateway.php:17
msgid "Not yet supported"
msgstr "아직 지원되지 않음"

#. translators: Tooltip of the currency settings of the direct bank transfer payment method.
#: classes/multi-currency/payment-gateways/class-wcml-payment-gateway-bacs.php:16
msgid "Set the currency in which your customer will see the final price when they checkout. Choose which accounts they will see in their payment message."
