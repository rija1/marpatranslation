#: inc/template-classes/class-wcml-troubleshooting-ui.php:104
#, php-format
msgid "To translate product taxonomies, go to the %1$sTaxonomy Translation%2$s page."
msgstr "Aby przetłumaczyć taksonomie produktów, przejdź do strony %1$sTłumaczenie taksonomii%2$s."

#. translators: First entry of the attribute dropdown of a repair tool: no attribute is picked. Lower case, as it sits in a list of attribute names.
#: inc/template-classes/class-wcml-troubleshooting-ui.php:111
msgid "none"
msgstr "brak"

#. translators: Heading of the group of repair tools for reviews. Verb phrase, imperative.
#: inc/template-classes/class-wcml-troubleshooting-ui.php:116
msgid "Fix missing product reviews"
msgstr "Napraw brakujące opinie o produktach"

#. translators: Label of the repair tool that makes reviews WPML has not registered available for translation.
