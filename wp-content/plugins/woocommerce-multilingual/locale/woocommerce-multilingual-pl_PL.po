msgstr "Usuń nieużywane pola własne z tłumaczeń produktów i wariantów"

#. translators: Button label that starts the ticked repair tools. Verb phrase, imperative.
#: inc/template-classes/class-wcml-troubleshooting-ui.php:139
msgid "Run the selected tools"
msgstr "Uruchom wybrane narzędzia"

#. translators: Label the run button changes to while the repair tools are working. A state, not a command.
#: inc/template-classes/class-wcml-troubleshooting-ui.php:141
msgid "Processing"
msgstr "Przetwarzanie"

#. translators: Heading above the read-only list of the plugin's settings on the Troubleshooting screen.
#: inc/template-classes/class-wcml-troubleshooting-ui.php:145
msgid "WPML Multilingual & Multicurrency for WooCommerce settings"
msgstr "Ustawienia WPML Multilingual & Multicurrency for WooCommerce"

#. translators: Progress line shown while the repair tools run. %s: how many items have been handled so far; the number counts up as the work goes on.
#: inc/template-classes/class-wcml-troubleshooting-ui.php:150
#, php-format
msgid "%s items processed"
msgstr "Przetworzono %s elementów"

