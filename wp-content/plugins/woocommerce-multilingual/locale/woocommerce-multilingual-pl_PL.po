msgstr "Synchronizuj zawartość koszyka przy zmianie języka"

#. translators: Label of the second option for a full cart on a language or currency switch: ask the shopper first, then empty the cart.
#: inc/template-classes/class-wcml-settings-ui.php:120
#: inc/template-classes/class-wcml-settings-ui.php:129
msgid "Prompt for a confirmation and reset the cart"
msgstr "Poproś o potwierdzenie i zresetuj koszyk"

