#. translators: Name of a ready-made colour scheme for the currency switcher.
#: inc/template-classes/currency-switcher/class-wcml-currency-switcher-options-dialog.php:44
msgid "Blue"
msgstr "Niebieski"

#. translators: Label of the colour field for the currency switcher's border. Noun.
#: inc/template-classes/currency-switcher/class-wcml-currency-switcher-options-dialog.php:49
msgid "Border"
msgstr "Obramowanie"

#. translators: Label of the colour field for the text of the currency the shopper is using.
#: inc/template-classes/currency-switcher/class-wcml-currency-switcher-options-dialog.php:51
msgid "Current currency font color"
msgstr "Kolor czcionki bieżącej waluty"

#. translators: Label of the colour field for the text of the currencies the shopper is not using.
#: inc/template-classes/currency-switcher/class-wcml-currency-switcher-options-dialog.php:53
msgid "Other currency font color"
msgstr "Kolor czcionki innej waluty"

#. translators: Label of the colour field for the background of the currency the shopper is using.
#: inc/template-classes/currency-switcher/class-wcml-currency-switcher-options-dialog.php:55
msgid "Current currency background color"
msgstr "Kolor tła bieżącej waluty"

#. translators: Label of the colour field for the background of the currencies the shopper is not using.
#: inc/template-classes/currency-switcher/class-wcml-currency-switcher-options-dialog.php:57
