msgstr "Zezwól na tłumaczenie brakujących opinii o produktach"

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: inc/template-classes/class-wcml-troubleshooting-ui.php:124
#, php-format
msgid "To translate product reviews, go to the %1$sTranslation Dashboard%2$s."
msgstr "Aby przetłumaczyć opinie o produktach, przejdź do %1$sKokpitu tłumaczeń%2$s."

#. translators: Heading of the group of repair tools that remove leftover data.
#: inc/template-classes/class-wcml-troubleshooting-ui.php:131
msgid "Cleanup tools"
msgstr "Narzędzia czyszczące"

#. translators: Label of the repair tool that deletes leftover custom fields from translations. Verb phrase, imperative.
#: inc/template-classes/class-wcml-troubleshooting-ui.php:134
