msgid "WPML Multilingual & Multicurrency for WooCommerce depends on several plugins to work. If any required plugin is missing, you should install and activate it."
msgstr "WPML Multilingual & Multicurrency for WooCommerce depende de varios plugins para funcionar. Si falta algún plugin necesario, debería instalarlo y activarlo."

#. translators: Heading of the block on the Status screen about the cart, checkout and other WooCommerce pages.
#: inc/template-classes/status/class-wcml-status-store-pages-ui.php:39
msgid "WooCommerce Store Pages"
msgstr "Páginas de la tienda WooCommerce"

#. translators: Explanation under the "WooCommerce Store Pages" heading; "this menu" is the block itself.
#: inc/template-classes/status/class-wcml-status-store-pages-ui.php:41
msgid "To run a multilingual e-commerce site, you need to have the WooCommerce shop pages translated to all the site's languages. Once all the pages are installed you can add the translations for them from this menu."
msgstr "Para gestionar un sitio de comercio electrónico multilingüe, debe tener las páginas de la tienda de WooCommerce traducidas a todos los idiomas del sitio. Una vez que todas las páginas estén instaladas, podrá añadir las traducciones para ellas desde este menú."

#. translators: Warning on the Status screen when a WooCommerce page is missing in the original language.
#: inc/template-classes/status/class-wcml-status-store-pages-ui.php:43
msgid "One or more WooCommerce pages have not been created."
msgstr "Una o más páginas de WooCommerce no se han creado."

#. translators: Button on the Status screen that creates the missing WooCommerce pages. Verb phrase, imperative.
#: inc/template-classes/status/class-wcml-status-store-pages-ui.php:45
msgid "Install WooCommerce Pages"
msgstr "Instalar las páginas de WooCommerce"

#. translators: Warning on the Status screen; the list of languages follows the colon.
#: inc/template-classes/status/class-wcml-status-store-pages-ui.php:47
msgid "WooCommerce store pages do not exist for these languages:"
msgstr "Las páginas de la tienda de WooCommerce no existen para estos idiomas:"

#. translators: Button on the Status screen that creates the missing translations of the WooCommerce pages. Verb phrase, imperative.
#: inc/template-classes/status/class-wcml-status-store-pages-ui.php:49
msgid "Create missing translations"
msgstr "Crear las traducciones que faltan"

#. translators: Line on the Status screen; the list of pages follows it, so keep the colon and the trailing space.
#: inc/template-classes/status/class-wcml-status-store-pages-ui.php:51
msgid "These pages are currently being translated by translators via WPML: "
msgstr "Los traductores están traduciendo actualmente estas páginas a través de WPML: "

#. translators: Line on the Status screen shown when every WooCommerce page has all its translations.
#: inc/template-classes/status/class-wcml-status-store-pages-ui.php:53
msgid "WooCommerce store pages are translated to all the site's languages."
msgstr "Las páginas de la tienda de WooCommerce están traducidas a todos los idiomas del sitio."

#. translators: Heading of the block on the Status screen that counts untranslated product categories, tags and attributes.
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:27
msgid "Taxonomies Missing Translations"
msgstr "Taxonomías con traducciones faltantes"

#. translators: Explanation under the "Taxonomies Missing Translations" heading.
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:29
msgid "To run a fully translated site, you should translate all taxonomy terms. Some store elements, such as variations, depend on taxonomy translation."
msgstr "Para tener un sitio totalmente traducido, debería traducir todos los términos de la taxonomía. Algunos elementos de la tienda, como las variaciones, dependen de la traducción de la taxonomía."

#. translators: %s is a taxonomy name
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:31
#, php-format
msgid "%s do not require translation."
msgstr "%s no requieren traducción."

#. translators: Status of one product category, tag or attribute on the Status screen.
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:33
msgid "This taxonomy requires translation."
msgstr "Esta taxonomía requiere traducción."

#. translators: Line on the Status screen counting untranslated terms of one taxonomy. %1$d: how many terms are missing translations, %2$s: the taxonomy's name, for example "product category".
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:35
#, php-format
msgid "%1$d %2$s is missing translations."
msgstr "A %1$d %2$s le faltan traducciones."

#. translators: Line on the Status screen counting untranslated terms of one taxonomy, when more than one is missing. %1$d: how many terms are missing translations, %2$s: the taxonomy's plural name, for example "product categories".
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:37
#, php-format
msgid "%1$d %2$s are missing translations."
msgstr "A %1$d %2$s les faltan traducciones."

#. translators: %s is a taxonomy name
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:39
#, php-format
msgid "Translate %s"
msgstr "Traducir %s"

#. translators: Status of one product category, tag or attribute on the Status screen.
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:41
msgid "This taxonomy does not require translation."
msgstr "Esta taxonomía no requiere traducción."

#. translators: %s is a taxonomy name
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:43
#, php-format
msgid "All %s are translated."
msgstr "Todos los %s están traducidos."

#. translators: Line on the Status screen shown when every product category, tag and attribute is translated.
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:45
msgid "Right now, there are no taxonomy terms needing translation."
msgstr "En este momento, no hay términos de taxonomía que necesiten traducción."

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: inc/template-classes/status/class-wcml-status-taxonomies-ui.php:47
#, php-format
msgid "To configure product taxonomies or attributes as translatable or not translatable, go to the %1$sMultilingual Content Setup%2$s"
msgstr "Para configurar las taxonomías o atributos de producto como traducibles o no traducibles, vaya a %1$sConfiguración del contenido multilingüe%2$s"

#. translators: Column heading above the untranslated URL part, on the store URLs screen. Noun.
#: inc/template-classes/store-urls/class-wcml-store-urls-edit-base-ui.php:50
msgid "Original"
msgstr "Original"

#. translators: Column heading above the translated URL part; the language name follows it on the same line, so the phrase stays open.
#: inc/template-classes/store-urls/class-wcml-store-urls-edit-base-ui.php:52
msgid "Translation to"
msgstr "Traducción al"

#. translators: Name of the URL part of the shop page, on the store URLs screen.
#: inc/template-classes/store-urls/class-wcml-store-urls-edit-base-ui.php:76
msgid "Product Shop Base"
msgstr "Base de la tienda de productos"

#. translators: Status shown for the language a URL part was written in, on the store URLs screen.
#: inc/template-classes/store-urls/class-wcml-store-urls-translation-statuses-ui.php:58
msgid "Original language"
msgstr "Idioma original"

#. translators: Link that reopens an already translated URL part because the original changed. Verb phrase, imperative.
#: inc/template-classes/store-urls/class-wcml-store-urls-translation-statuses-ui.php:60
msgid "Update translation"
msgstr "Actualizar traducción"

#. translators: Link that translates a URL part for the first time, on the store URLs screen. Verb phrase, imperative.
#: inc/template-classes/store-urls/class-wcml-store-urls-translation-statuses-ui.php:62
msgid "Add translation"
msgstr "Añadir traducción"

#. translators: Link that changes the existing translation of a URL part. Verb phrase, imperative.
#: inc/template-classes/store-urls/class-wcml-store-urls-translation-statuses-ui.php:64
msgid "Edit translation"
msgstr "Editar traducción"

#. translators: Introduction at the top of the store URLs screen.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:61
msgid "This page allows you to translate all strings that are being used by WooCommerce in building different type of urls. Translating them enables you to have fully localized urls that match the language of the pages."
msgstr "Esta página le permite traducir todas las cadenas que WooCommerce utiliza para crear diferentes tipos de URL. Traducirlas le permite tener URL totalmente localizadas que coincidan con el idioma de las páginas."

#. translators: %1$s/%2$s and %3$s/%4$s are opening and closing HTML link tags
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:64
#, php-format
msgid "You can enter or edit your default values on the %1$sPermalinks settings%2$s page or, for the endpoints, on the WooCommerce %3$sAdvanced settings%4$s page."
msgstr "Puede introducir o editar sus valores predeterminados en la página de %1$sajustes de enlaces permanentes%2$s o, para los endpoints, en la página de %3$sajustes avanzados%4$s de WooCommerce."

#. translators: Link text inside a sentence on the store URLs screen; it opens the WordPress permalink settings. Lower case because it sits mid-sentence.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:74
msgid "permalinks settings"
msgstr "ajustes de enlaces permanentes"

#. translators: Link text on the store URLs screen; it opens the WooCommerce account settings.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:76
msgid "Account settings"
msgstr "Ajustes de la cuenta"

#. translators: Column heading naming which URL part a row is about, on the store URLs screen; a slug is the readable part of a web address.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:78
msgid "Slug type"
msgstr "Tipo de slug"

#. translators: Column heading above the untranslated URL part, on the store URLs screen.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:80
msgid "Original Slug"
msgstr "Slug original"

#. translators: Row label on the store URLs screen for the address of the WooCommerce shop page.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:82
msgid "Shop page"
msgstr "Página de la tienda"

#. translators: Row label on the store URLs screen for the URL part that precedes every product address.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:84
msgid "Product base"
msgstr "Base del producto"

#. translators: Row label on the store URLs screen for the URL part that precedes every product-category address.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:86
msgid "Product category base"
msgstr "Base de la categoría de producto"

#. translators: Row label on the store URLs screen for the URL part that precedes every product-tag address.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:88
msgid "Product tag base"
msgstr "Base de la etiqueta de producto"

#. translators: Row label on the store URLs screen for the URL part that precedes every product-attribute address.
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:90
msgid "Product attribute base"
msgstr "Base del atributo de producto"

#. translators: %s is a slug
#: inc/template-classes/store-urls/class-wcml-store-urls-ui.php:94
#, php-format
msgid "Attribute slug: %s"
msgstr "Slug del atributo: %s"

#. translators: Name of the kind of content being translated, shown at the top of WPML's translation editor. Noun, singular.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:117
msgid "Product"
msgstr "Producto"

#. translators: Label of the field holding the readable part of a product's web address, in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:187
msgid "Slug"
msgstr "Slug"

#. translators: Label of the main body-text field of a product in WPML's translation editor; the two words are the names WooCommerce and WordPress each give the same field.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:198
msgid "Content / Description"
msgstr "Contenido / Descripción"

#. translators: Heading of the short-description field of a product in WPML's translation editor. It is the WordPress field name.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:202
msgid "Excerpt"
msgstr "Extracto"

#. translators: Heading of the field holding the message a shopper gets after buying the product, in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:207
msgid "Purchase note"
msgstr "Nota de compra"

#. translators: Heading of the group of product image fields in WPML's translation editor. Noun, plural.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:216
msgid "Images"
msgstr "Imágenes"

#. translators: Heading of the group of attributes defined on this product alone, in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:227
msgid "Custom Product attributes"
msgstr "Atributos de producto personalizados"

#. translators: Label of the field holding a custom attribute's values in WPML's translation editor; the brackets say there may be one or several.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:234
msgid "Value(s)"
msgstr "Valor(es)"

#. translators: Heading of the group of extra product fields in WPML's translation editor. It is the WordPress term for them.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:250
msgid "Custom Fields"
msgstr "Campos personalizados"

#. translators: Heading of the group of a product's variation fields in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:300
msgid "Variations data"
msgstr "Datos de las variaciones"

#. translators: %s is a product ID
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:314
#, php-format
msgid "Download Files for Variation #%s"
msgstr "Archivos descargables para la variación n.º %s"

#. translators: Heading of the group of downloadable-file fields of a product in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:317
msgid "Download Files"
msgstr "Archivos descargables"

#. translators: Label of the field holding the web address of a downloadable file, in WPML's translation editor.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:328
msgid "File URL"
msgstr "URL del archivo"

#. translators: Heading of the group of fields of a product sold on another site, in WPML's translation editor. It is the WooCommerce product type.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:341
msgid "External Product"
msgstr "Producto externo"

#. translators: Label of the field holding the address of the other site where an external product is sold.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:343
msgid "Product url"
msgstr "URL del producto"

#. translators: Label of the field holding what the buy button of an external product says.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:345
msgid "Button text"
msgstr "Texto del botón"

#. translators: Warning above the product-category and tag fields in WPML's translation editor: the translation is shared by every product using that term.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:361
msgid "Changes in these translations will affect terms in general! ( Not only for this product )"
msgstr "¡Los cambios en estas traducciones afectarán a los términos en general! ( No solo para este producto )"

#. translators: Error returned when a product translation is saved with none of its three main fields filled in.
#: inc/translation-editor/class-wcml-editor-ui-product-job.php:713
msgid "Content, title, and excerpt are empty."
msgstr "El contenido, el título y el extracto están vacíos."
